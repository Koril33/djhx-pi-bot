[Unit]
Description=djhx-pi-bot (Telegram pi bridge)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/project/djhx-pi-bot
Environment=PATH=/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pi/project/djhx-pi-bot/.venv/bin/python /home/pi/project/djhx-pi-bot/data/deploy-state/service-entry.py
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=15
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
