[Unit]
Description=djhx-pi-bot (Telegram pi bridge)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/project/djhx-pi-bot
Environment=PATH=/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pi/project/djhx-pi-bot/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8128
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
