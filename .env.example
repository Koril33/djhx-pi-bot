# ============ Telegram ============
BOT_TOKEN=
# 允许使用的 Telegram user id，逗号分隔
ALLOWED_USER_IDS=

# Webhook 路径密钥（随机长字符串）与完整 webhook URL
WEBHOOK_SECRET=
WEBHOOK_URL=

# Gitea Push webhook 密钥（用于自动部署）
DEPLOY_SECRET=
# 若 Gitea webhook 也配置了 Secret，可设为 true 强制验证签名
DEPLOY_REQUIRE_SIGNATURE=false
# 可填仓库完整名称，限制部署事件来源，如 koril/djhx-pi-bot
DEPLOY_REPO_FULL_NAME=koril/djhx-pi-bot

# ============ pi ============
PI_CMD=pi
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
PI_SESSION_DIR=data/pi-sessions

# ============ 存储 / 服务 ============
DB_PATH=data/bot.db
PRICING_FILE=pricing.json
COST_TRACKING_ENABLED=true
COST_AUTO_REPORT=true

# ============ 单管理员后台 ============
# 同时配置后开放 /admin；只写在 .env，不提交真实密码
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SMTP 授权码由后台保存到项目 .env；数据库只保存 env:SMTP_PASSWORD 引用
# 首次启动会迁移旧数据库明文密码；此项不要提交真实值
SMTP_PASSWORD=

MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACT=true
# 自动摘要固定 deepseek/deepseek-flash；以下仅调节记忆数量与长度等预算
MEMORY_BATCH_TURNS=5
MEMORY_SUMMARY_RETRY_SECONDS=3600
MEMORY_TURN_RETENTION=20
MEMORY_TURN_USER_CHARS=4000
MEMORY_TURN_ASSISTANT_CHARS=8000
MEMORY_SUMMARY_INPUT_MAX_BYTES=16000
MEMORY_SUMMARY_RESPONSE_MAX_BYTES=8192
MEMORY_ACTIVE_LIMIT=100
MEMORY_ITEM_MAX_CHARS=240
MEMORY_INJECT_MAX_ITEMS=6
MEMORY_INJECT_MAX_BYTES=4096
MEMORY_SUMMARY_MAX_BYTES=1536
MEMORY_ITEMS_MAX_BYTES=2048
MEMORY_CONTEXT_DIR=data/memory-context
HOST=127.0.0.1
PORT=8128
WEBHOOK_QUEUE_CAPACITY=1000
WEBHOOK_WORKER_CONCURRENCY=8
WEBHOOK_STEER_CONCURRENCY=4
WEBHOOK_MAX_BYTES=2097152
SHUTDOWN_DRAIN_SECONDS=30

# ============ Telegram 网络恢复 ============
# initialize/getMe、start 和命令注册遇到网络异常时指数退避；错误 token 立即失败
TELEGRAM_RETRY_INITIAL_SECONDS=3
TELEGRAM_RETRY_MAX_SECONDS=60
# 运行时探活间隔，以及更新消费者异常退出后的恢复间隔
TELEGRAM_PROBE_INTERVAL_SECONDS=60
UPDATE_WORKER_RETRY_SECONDS=3

# ============ 数据库与完整会话备份 ============
# 不包含 .env / Pi 的模型凭据；包含用户消息，旧版本备份可能含 SMTP 明文密码
BACKUP_ENABLED=true
BACKUP_ROOT=data/backups
# 最近成功备份已满一个周期时备份；首次启动且没有备份时也会执行
BACKUP_INTERVAL_SECONDS=86400
# 等待队列与会话空闲的上限；忙碌或失败时延后再试，不强制终止任务
BACKUP_IDLE_TIMEOUT_SECONDS=120

# ============ 受限语音与 PDF ============
# 先运行 uv run python -m scripts.prepare_voice 下载并校验固定本地模型
VOICE_ENABLED=true
VOICE_MODEL_DIR=data/voice-model
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=10485760
VOICE_TRANSCRIBE_TIMEOUT_SECONDS=120
# 仅提取含文字且未加密的 PDF；扫描件请发送图片
PDF_MAX_BYTES=5242880
PDF_MAX_PAGES=30
PDF_MAX_CHARS=30000
PDF_PARSE_TIMEOUT_SECONDS=20

# ============ 日志 ============
LOG_LEVEL=INFO
LOG_DIR=logs

# ============ Telegram 流式回复 ============
# 首批文本最多缓冲 250ms 或累计 16 字符，后续最快每 600ms 编辑一次
STREAM_INITIAL_DELAY=0.25
STREAM_INITIAL_CHARS=16
STREAM_EDIT_INTERVAL=0.6
