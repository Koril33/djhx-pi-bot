# ============ Telegram ============
BOT_TOKEN=
# 允许使用的 Telegram user id，逗号分隔
ALLOWED_USER_IDS=

# Webhook 路径密钥（随机长字符串）与完整 webhook URL
WEBHOOK_SECRET=
WEBHOOK_URL=

# Gitea Push webhook 密钥（用于自动部署）
DEPLOY_SECRET=

# ============ pi ============
PI_CMD=pi
PI_PROVIDER=deepseek
PI_MODEL=deepseek-v4-flash
PI_SESSION_DIR=data/pi-sessions

# ============ 存储 / 服务 ============
DB_PATH=data/bot.db
HOST=127.0.0.1
PORT=8128

# ============ 日志 ============
LOG_LEVEL=INFO
LOG_DIR=logs
